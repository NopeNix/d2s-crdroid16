<!-- Nopenix local manifest for crDroid 16.0 / d2s (Galaxy Note10+ SM-N975F)

Usage: place as .repo/local_manifests/nopenix.xml after
  repo init -u https://github.com/crdroidandroid/android.git -b 16.0
This file supplies everything the crDroid manifest does NOT include for d2s:
device tree, common tree, kernel, vendor blobs, and Samsung hardware deps.
Base: Lineage 23.2 for hardware deps (matches crDroid 16.0's default.xml).
Blobs: TheMuppets lineage-23.2 (decision: docs/blob-strategy.md).
Falls back to NopeNix crDroid blob forks (branches 14.0 / 13.0) if needed —
comment/uncomment the marked blocks.
-->
<manifest>
  <!-- Device -->
  <project name="NopeNix/android_device_samsung_d2s" path="device/samsung/d2s" remote="github" revision="16.0" />
  <project name="NopeNix/android_device_samsung_exynos9820-common" path="device/samsung/exynos9820-common" remote="github" revision="16.0" />
  <project name="NopeNix/android_kernel_samsung_exynos9820" path="kernel/samsung/exynos9820" remote="github" revision="16.0" />

  <!-- Vendor blobs — default: TheMuppets lineage-23.2 -->
  <project name="TheMuppets/proprietary_vendor_samsung_d2s" path="vendor/samsung/d2s" remote="github" revision="lineage-23.2" />
  <project name="TheMuppets/proprietary_vendor_samsung_exynos9820-common" path="vendor/samsung/exynos9820-common" remote="github" revision="lineage-23.2" />

  <!-- FALLBACK blobs (crDroid forks, older). Comment the two TheMuppets lines above
       and uncomment these two to switch. See docs/blob-strategy.md.
  <project name="NopeNix/proprietary_vendor_samsung_d2s" path="vendor/samsung/d2s" remote="github" revision="14.0" />
  <project name="NopeNix/proprietary_vendor_samsung_exynos9820-common" path="vendor/samsung/exynos9820-common" remote="github" revision="13.0" />
  -->

  <!-- Hardware dependencies (referenced by exynos9820-common lineage.dependencies) -->
  <project name="LineageOS/android_device_samsung_slsi_sepolicy" path="device/samsung_slsi/sepolicy" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung" path="hardware/samsung" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung_slsi-linaro_config" path="hardware/samsung_slsi-linaro/config" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung_slsi-linaro_exynos" path="hardware/samsung_slsi-linaro/exynos" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung_slsi-linaro_exynos5" path="hardware/samsung_slsi-linaro/exynos5" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung_slsi-linaro_graphics" path="hardware/samsung_slsi-linaro/graphics" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung_slsi-linaro_interfaces" path="hardware/samsung_slsi-linaro/interfaces" remote="github" revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_samsung_slsi-linaro_openmax" path="hardware/samsung_slsi-linaro/openmax" remote="github" revision="lineage-23.2" />
</manifest>
